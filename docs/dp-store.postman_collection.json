                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"individual\",\n  \"phone\": \"{{phone}}\",\n  \"country_code\": \"966\",\n  \"name\": \"عميل تجريبي\",\n  \"city\": \"الرياض\",\n  \"email\": null,\n  \"terms\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
