        {
          "name": "Verify OTP → token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "يدمج سلة الضيف (X-Cart-Token) مع حساب المستخدم ويرجع Bearer token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{otp_code}}\",\n  \"device_name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); pm.collectionVariables.set('cart_token', ''); }"
                ]
              }
            }
          ]
        },
