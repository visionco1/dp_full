APP_NAME="دفع المحركات"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# للـ MySQL: DB_CONNECTION=mysql DB_HOST=127.0.0.1 DB_PORT=3306 DB_DATABASE=dp DB_USERNAME=root DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# رمز التحقق يرجع في استجابة الـ API (للتجربة فقط — أوقفه في الإنتاج)
DP_OTP_DEBUG=true
DP_SMS_DRIVER=log
DP_SELLER_VAT=300000000000003
